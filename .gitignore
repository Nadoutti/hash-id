.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pylint.d/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
*.cover

# ---------------------------------------------------------------------------
# ML: artefatos e dados (src/ml, assets/)
