# ---------------------------------------------------------------------------
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.ckpt
*.npy
*.npz
models/
checkpoints/
runs/
mlruns/
wandb/

# Datasets grandes; libere caso a caso com `!assets/exemplo.csv`
assets/**/*.csv
assets/**/*.tsv
assets/**/*.parquet
assets/**/*.jsonl
assets/**/*.txt
assets/**/*.zip
assets/**/*.gz

# ---------------------------------------------------------------------------
# Segredos e configuração local — NUNCA commitar
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json
.secrets/

# ---------------------------------------------------------------------------
